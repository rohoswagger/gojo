{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gojo-web",
  "compatibility_date": "2026-08-14",
  // Pure static assets — the exported Next.js site, no Worker script and no
  // server runtime to pay for.
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  // Cloudflare manages the DNS records for these. `public/_redirects` keeps
  // serving /appcast.xml -> updates.trygojo.com, which installs <=1.3.0 still
  // request and cannot be repointed.
  "routes": [
    { "pattern": "trygojo.com", "custom_domain": true },
    { "pattern": "www.trygojo.com", "custom_domain": true }
  ]
}
