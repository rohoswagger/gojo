{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gojo-web",
  "compatibility_date": "2026-08-14",
  // Keep the static export while redirecting the duplicate www host before
  // falling through to Cloudflare's static-assets binding.
  "main": "worker.mjs",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Static assets are otherwise served before the Worker, which would skip
    // the canonical-host redirect for every existing page.
    "run_worker_first": true
  },
  // Cloudflare manages the DNS records for these. `public/_redirects` keeps
  // serving /appcast.xml -> updates.trygojo.com, which installs <=1.3.0 still
  // request and cannot be repointed.
  "routes": [
    { "pattern": "trygojo.com", "custom_domain": true },
    { "pattern": "www.trygojo.com", "custom_domain": true }
  ]
}
